{
  "name": "kanwas",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @kanwas/desktop dev",
    "build": "pnpm --filter @kanwas/desktop build",
    "package:desktop": "pnpm --filter @kanwas/desktop package",
    "package:desktop:dir": "pnpm --filter @kanwas/desktop package:dir",
    "test": "pnpm --filter shared test && pnpm --filter @kanwas/yjs-core test && pnpm --filter @kanwas/local-runtime test && pnpm --filter @kanwas/renderer test",
    "build:website": "pnpm --filter website build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "pnpm exec prettier --write"
    ],
    "renderer/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @kanwas/renderer run lint --fix"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "patchedDependencies": {
      "@blocknote/core@0.46.0": "patches/@blocknote__core@0.46.0.patch"
    },
    "overrides": {
      "prosemirror-view": "1.41.4",
      "@blocknote/core": "0.46.0",
      "@blocknote/server-util": "0.46.0"
    }
  }
}
