#!/usr/bin/env bash
# `kanwas` launcher wrapper — runs the compiled CLI (dist/cli.js).
# Resolves its own location so it works from any directory and via a symlink.
set -euo pipefail

# Resolve this script's real directory (following symlinks).
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
PKG_DIR="$(cd "$BIN_DIR/.." >/dev/null 2>&1 && pwd)"
CLI="$PKG_DIR/dist/cli.js"

if [ ! -f "$CLI" ]; then
  echo "kanwas: $CLI not found — build the daemon first:" >&2
  echo "  pnpm --filter local-daemon build" >&2
  exit 1
fi

exec node "$CLI" "$@"
