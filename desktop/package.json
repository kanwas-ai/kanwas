{
  "name": "@kanwas/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first visual workspace for notes, canvases, files, and AI tools",
  "author": {
    "name": "Kanwas contributors",
    "email": "kanwas-ai@users.noreply.github.com"
  },
  "homepage": "https://kanwas.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/kanwas-ai/kanwas.git"
  },
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "bundle": "node build.mjs",
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "prepare:app": "pnpm --filter shared build && pnpm --filter @kanwas/yjs-core build && pnpm --filter @kanwas/local-runtime build && pnpm --filter @kanwas/renderer build",
    "rebuild:native": "electron-rebuild -f -w node-pty --module-dir .",
    "dev": "pnpm prepare:app && pnpm rebuild:native && pnpm bundle && electron .",
    "build": "pnpm prepare:app && pnpm bundle",
    "package": "pnpm build && electron-builder --publish never",
    "package:dir": "pnpm build && electron-builder --dir --publish never",
    "package:mac": "pnpm build && electron-builder --mac --publish never",
    "package:win": "pnpm build && electron-builder --win --publish never",
    "package:linux": "pnpm build && electron-builder --linux --publish never",
    "smoke:package": "node scripts/smoke-packaged.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "jsdom": "25.0.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@kanwas/local-runtime": "workspace:*",
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^22.19.0",
    "electron": "^43.1.1",
    "electron-builder": "26.15.7",
    "esbuild": "^0.25",
    "shared": "workspace:*",
    "typescript": "^5.7.2"
  }
}
