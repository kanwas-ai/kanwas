{
  "name": "@kanwas/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "bundle": "node build.mjs",
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "prepare:app": "pnpm --filter shared build && pnpm --filter @kanwas/yjs-core build && pnpm --filter @kanwas/local-runtime build && pnpm --filter @kanwas/renderer build",
    "rebuild:native": "electron-rebuild -f -w node-pty --module-dir .",
    "dev": "pnpm prepare:app && pnpm rebuild:native && pnpm bundle && electron .",
    "build": "pnpm prepare:app && pnpm bundle",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@kanwas/local-runtime": "workspace:*",
    "jsdom": "25.0.1",
    "node-pty": "^1.1.0",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^22.19.0",
    "electron": "^43.1.1",
    "esbuild": "^0.25",
    "typescript": "^5.7.2"
  }
}
