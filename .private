# Paths to strip from the public mirror.
#
# One literal path per line (relative to repo root). A directory entry like
# `private/` removes the directory and everything under it. Blank lines and
# `#` comments are ignored. Consumed by bin/publish-public-mirror.sh.

private/
.private
e2b.toml
execenv/e2b.staging.toml
execenv/e2b.production.toml
admin
backend/resources/admin
backend/start/admin_routes.ts
website
